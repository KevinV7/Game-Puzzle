# Copy to .env and replace every change-me value. Never commit .env.

# Required when DJANGO_DEBUG=0 (startup fails without it).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# Keep 127.0.0.1 in the list: the web healthcheck calls it directly.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Must include the scheme and published port (see PROXY_PORT).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Set to 1 once TLS terminates in front of the proxy.
DJANGO_SECURE_COOKIES=0
DJANGO_TIME_ZONE=UTC

POSTGRES_DB=juego
POSTGRES_USER=juego
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

GUNICORN_WORKERS=3
PROXY_PORT=8080
